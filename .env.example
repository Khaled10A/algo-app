GROQ_API_KEY=your_groq_api_key_here
ALLOWED_ORIGIN=https://algo-app-lilac.vercel.app

# Optional — enables a shared rate limit (15 req/min per IP) across
# serverless instances instead of the per-instance in-memory fallback.
# Create a free database at https://console.upstash.com and copy the REST URL/TOKEN.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
